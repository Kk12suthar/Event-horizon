# Byte-compiled Python
__pycache__/
*.py[cod]

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Local environments
.venv/
venv/
.env
.env.local

# Runtime data generated by the app (kept as empty dirs via their own .gitignore)
uploads/*
!uploads/.gitignore
thumbnails/*
!thumbnails/.gitignore
logs/*
!logs/.gitignore
upload_states/*

# Real credentials - never commit these, use .env.example as the template
firebase-credentials.json
client_secret_*.json
*service-account*.json
