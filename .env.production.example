# Deployment image coordinates
GCP_PROJECT_ID=your-billed-project
GCP_REGION=us-central1
ARTIFACT_REPOSITORY=eventhorizon
APP_DOMAIN=eventhorizon.203-0-113-10.sslip.io
ACME_EMAIL=you@example.com

# Public origin used by backend and agent CORS
ENVIRONMENT=production
FRONTEND_URL=https://eventhorizon.203-0-113-10.sslip.io
DOMAIN_ADDRESS=https://eventhorizon.203-0-113-10.sslip.io
AGENT_CORS_ORIGINS=https://eventhorizon.203-0-113-10.sslip.io

# PostgreSQL - use a long random value in production
POSTGRES_USER=eventhorizon
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DBNAME=postgres
POSTGRES_UPLOAD_DBNAME=postgres
POSTGRES_METADATA_DBNAME=postgres
POSTGRES_CHARTS_DB_NAME=postgres
POSTGRES_UPLOAD_SCHEMA=uploads
AGENT_FOLDER_SCHEMA_PREFIX=folder

# Auth - Firebase credentials are mounted as a separate Secret Manager secret
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
ENABLE_DEV_GMAIL_SIGNIN=false
AUTH_DISABLED=false
PORTAL_AUTH_ENFORCED=true

# Effective agent model. Vertex AI credentials are intentionally not used.
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-5.4-mini
MODEL_NAME=gpt-5.4-mini
OPENAI_API_KEY=replace-with-openai-api-key
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096
AGENT_LLM_TIMEOUT=90
AGENT_LOG_LEVEL=INFO
AGENT_EXPOSE_ERRORS=false
AGENT_SQL_TIMEOUT_MS=30000
AGENT_SQL_ROW_LIMIT=5000

# Optional mail delivery
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=
