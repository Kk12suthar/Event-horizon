# Deployment image coordinates
GCP_PROJECT_ID=your-billed-project
GCP_REGION=us-central1
ARTIFACT_REPOSITORY=eventhorizon
APP_DOMAIN=eventhorizon.203-0-113-10.sslip.io
ACME_EMAIL=you@example.com

# Public origin used by backend and agent CORS
ENVIRONMENT=production
FRONTEND_URL=https://eventhorizon.203-0-113-10.sslip.io
DOMAIN_ADDRESS=https://eventhorizon.203-0-113-10.sslip.io
AGENT_CORS_ORIGINS=https://eventhorizon.203-0-113-10.sslip.io

# PostgreSQL - use a long random value in production
POSTGRES_USER=eventhorizon
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DBNAME=postgres
POSTGRES_UPLOAD_DBNAME=postgres
POSTGRES_METADATA_DBNAME=postgres
POSTGRES_CHARTS_DB_NAME=postgres
POSTGRES_UPLOAD_SCHEMA=uploads
AGENT_FOLDER_SCHEMA_PREFIX=folder

# Auth - Firebase credentials are mounted as a separate Secret Manager secret
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
ENABLE_DEV_GMAIL_SIGNIN=false
AUTH_DISABLED=false
PORTAL_AUTH_ENFORCED=true

# Production users configure their own provider, model, and encrypted API key.
# Provider keys from this deployment environment are intentionally unavailable.
MODEL_CONFIG_MODE=user

# Storage policy: measured filesystem capacity, 25%/15 GiB reserve, 50 users, 5x materialization.
# The values below are hard caps; the server rounds them down when the mounted
# filesystem cannot safely support them (currently 3 files, 55 MiB each, 175 MiB retained per user).
UPLOAD_PLANNED_USERS=50
UPLOAD_MAX_FILES_PER_USER=3
UPLOAD_FILE_SIZE_CAP_BYTES=62914560
UPLOAD_USER_QUOTA_CAP_BYTES=188743680
UPLOAD_STORAGE_EXPANSION_FACTOR=5
UPLOAD_STORAGE_RESERVE_PERCENT=25
UPLOAD_MIN_FREE_BYTES=16106127360
UPLOAD_MAX_CHUNK_BYTES=1048576

# One agent-created prepared table per account.
MAX_PREPARED_TABLES_PER_USER=1

# Agent request limits. Provider/model values come from each user's Model Access.
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096
AGENT_LLM_TIMEOUT=90
AGENT_LOG_LEVEL=INFO
AGENT_EXPOSE_ERRORS=false
AGENT_SQL_TIMEOUT_MS=30000
AGENT_SQL_ROW_LIMIT=5000

# Optional mail delivery
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=
