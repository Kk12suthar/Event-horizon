# Shared environment for backend + agent-server.
# Copy this file to `.env` at the workspace root and fill in real values.

# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:5174
DOMAIN_ADDRESS=http://127.0.0.1:5174
ENABLE_DEV_GMAIL_SIGNIN=true

# -----------------------------------------------------------------------------
# PostgreSQL - required for backend metadata, uploads, sessions, and agent tools
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend DB names
POSTGRES_UPLOAD_DBNAME=postgres
POSTGRES_METADATA_DBNAME=postgres
POSTGRES_CHARTS_DB_NAME=postgres

# Agent DB name and folder-scoped table view settings
POSTGRES_DBNAME=postgres
POSTGRES_UPLOAD_SCHEMA=uploads
AGENT_FOLDER_SCHEMA_PREFIX=folder

# -----------------------------------------------------------------------------
# Backend auth / security - required
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_KEY_ENCRYPTION_KEY=replace-with-32-plus-random-characters

# Firebase auth - required for real Firebase sign-in/sign-up
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
# Backend reads backend/firebase-credentials.json directly (not committed).
# Download your own service account key from the Firebase console and place
# it at that path, or update backend/router/authService.py to read a
# different path.
FIREBASE_CREDENTIALS_PATH=backend/firebase-credentials.json

# -----------------------------------------------------------------------------
# Agent model runtime - required for live LLM calls
# Recommended OpenRouter pattern: one key, many model slugs.
# UI model input `openai/gpt-4o` becomes LiteLLM model `openrouter/openai/gpt-4o`.
# -----------------------------------------------------------------------------
AGENT_PROVIDER=openrouter
AGENT_MODEL=openrouter/openai/gpt-4o
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OR_SITE_URL=http://127.0.0.1:5174
OR_APP_NAME=EventHorizon
AGENT_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT=30

# Optional direct-provider keys if not using OpenRouter
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional generic aliases; agent maps these to the selected provider when present.
MODEL_PROVIDER=
MODEL_NAME=
AGENT_API_KEY=
MODEL_API_KEY=
AGENT_API_BASE=

# -----------------------------------------------------------------------------
# Agent operational limits / paths
# -----------------------------------------------------------------------------
AGENT_LOG_LEVEL=INFO
AGENT_ARTIFACT_ROOT=agent-server/artifacts
AGENT_EXPOSE_ERRORS=false
AGENT_SQL_TIMEOUT_MS=30000
AGENT_SQL_ROW_LIMIT=30

# -----------------------------------------------------------------------------
# Email - optional unless using forgot-password/invitation mail delivery
# -----------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# Admin/license model-config records - required only for backend data-collection APIs
# -----------------------------------------------------------------------------
LICENSE_ID=
MODEL_CONFIG_KEY=
INVOCATION_STACKS=

# -----------------------------------------------------------------------------
# Legacy/local operational values still referenced by backend code
# -----------------------------------------------------------------------------
USER_ID=
BACKUP_RETENTION=5
PERIODIC_INTERVAL=300
MAX_INCREMENTAL_BACKUPS=15
MAX_CHECKPOINT_BACKUPS=3

# Bootstrap security - optional
BOOTSTRAP_IP_ALLOWLIST=
BOOTSTRAP_RATE_LIMIT=5
BOOTSTRAP_RATE_WINDOW=3600
BOOTSTRAP_LOCKOUT_THRESHOLD=3
BOOTSTRAP_LOCKOUT_DURATION=3600

# Dev auth toggles - optional
AUTH_DISABLED=false
DEFAULT_USER_EMAIL=dev@local
PORTAL_AUTH_ENFORCED=false
